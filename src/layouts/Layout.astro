---
import '@aifuxi/semi-theme-default/base.css'
import '@aifuxi/semi-theme-default/button.css'
import '@aifuxi/semi-theme-default/icon.css'
import '@aifuxi/semi-theme-default/layout.css'
import '@aifuxi/semi-theme-default/typography.css'
import IconArrowUp from '@aifuxi/semi-icons-vue/icons/IconArrowUp'
import { Layout, LayoutFooter, LayoutHeader } from '@aifuxi/semi-ui-vue/layout'
import { Text } from '@aifuxi/semi-ui-vue/typography'
import BrandLogo from '../assets/brand-logo.svg'
import ThemeMenu from '../components/islands/ThemeMenu.vue'
import ModernTheme from '../components/ModernTheme.astro'
import { site } from '../config/site'
import '../styles/site.css'

interface Props {
  title?: string
  description: string
  noindex?: boolean
  article?: {
    publishedAt: string
    updatedAt?: string
    image?: { src: string; alt: string }
  }
}

const { title, description, noindex, article } = Astro.props
const pageTitle = title ? `${title} · ${site.name}` : site.name
const currentPath = Astro.url.pathname.replace(/\/?$/, '/')
const canonical = !noindex && Astro.site && new URL(currentPath, Astro.site)
const image = article?.image ?? { src: '/apple-icon.png', alt: site.name }
const imageUrl = canonical ? new URL(image.src, canonical).href : undefined

const structuredData = article &&
  canonical && {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: canonical.href,
    mainEntityOfPage: canonical.href,
    datePublished: article.publishedAt,
    dateModified: article.updatedAt,
    author: { '@type': 'Person', name: site.author, url: new URL('/about/', canonical).href },
    inLanguage: site.language,
    image: article.image && imageUrl,
  }

const navigation = [
  { href: '/blog/', label: '文章', relatedPaths: ['/tags/', '/archives/'] },
  { href: '/categories/', label: '主题' },
  { href: '/projects/', label: '项目' },
  { href: '/about/', label: '关于' },
]
---

<!doctype html>
<html lang={site.language} id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" />
    <ModernTheme />
    <script is:inline>
      try {
        const theme = localStorage.getItem('blog-theme')
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme
        }
      } catch {
        // 存储被禁用时由 CSS 跟随系统主题。
      }
    </script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && (
      <>
        <link rel="canonical" href={canonical.href} />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:type" content={article ? 'article' : 'website'} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical.href} />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:alt" content={image.alt} />
        {article && <meta property="article:published_time" content={article.publishedAt} />}
        {article?.updatedAt && (
          <meta property="article:modified_time" content={article.updatedAt} />
        )}
      </>
    )}
    {Astro.site && (
      <>
        <link
          rel="alternate"
          type="application/rss+xml"
          title={site.name}
          href={new URL(site.rssPath, Astro.site)}
        />
        <link rel="sitemap" href={new URL(site.sitemapPath, Astro.site)} />
      </>
    )}
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}
      />
    )}
    <title>{pageTitle}</title>
  </head>
  <body>
    <script is:inline>
      const theme = document.documentElement.dataset.theme
      if (theme === 'dark' || (!theme && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.body.setAttribute('theme-mode', 'dark')
      }
    </script>
    <Layout class="site-layout">
      <Text class="skip-link" link={{ href: '#main' }}>
        跳到正文
      </Text>
      <LayoutHeader tagName="header" class="site-header">
        <div class="site-shell site-bar site-header-bar">
          <a class="site-brand" href="/" aria-label={`${site.name}，返回首页`}>
            <BrandLogo aria-hidden="true" focusable="false" />
            <span>{site.name}</span>
          </a>
          <div class="site-header-actions">
            <nav aria-label="主导航">
              <ul class="site-nav">
                {navigation.map(({ href, label, relatedPaths }) => (
                  <li>
                    <a
                      href={href}
                      aria-current={
                        currentPath === href
                          ? 'page'
                          : currentPath.startsWith(href) ||
                              relatedPaths?.some((path) => currentPath.startsWith(path))
                            ? 'location'
                            : undefined
                      }
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <ThemeMenu client:load />
          </div>
        </div>
      </LayoutHeader>
      <slot />
      <LayoutFooter tagName="footer" role="contentinfo" class="site-footer">
        <div class="site-shell site-bar footer-bar">
          <div class="footer-links">
            <Text type="secondary">{site.author}</Text>
            <a href={site.rssPath} class="site-link">
              RSS 订阅
            </a>
            <a
              href="/friends/"
              class="site-link"
              aria-current={currentPath === '/friends/' ? 'page' : undefined}
            >
              友链
            </a>
          </div>
          <ul class="footer-filings" role="list" aria-label="网站备案">
            {site.filings.map(({ label, href, icon }) => (
              <li>
                <a class:list={['site-link', { 'icon-label': icon }]} href={href}>
                  {icon && <img src={icon.src} width="14" height="14" alt="" />}
                  {label}
                </a>
              </li>
            ))}
          </ul>
          <a class="site-link icon-label footer-top" href="#top">
            <IconArrowUp aria-hidden="true" />
            返回顶部
          </a>
        </div>
      </LayoutFooter>
    </Layout>
    <script>
      const root = document.documentElement
      const header = document.querySelector<HTMLElement>('.site-header')

      if (header) {
        new ResizeObserver(() => {
          root.style.setProperty('--blog-sticky-header-height', `${header.offsetHeight}px`)
        }).observe(header)
      }
    </script>
  </body>
</html>

<style>
  .footer-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    padding-block: 12px;
  }

  .footer-filings {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  .footer-top {
    justify-self: end;
  }

  @media (max-width: 36rem) {
    .footer-bar {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .footer-top {
      justify-self: center;
    }

    .footer-links {
      justify-content: center;
    }
  }
</style>
