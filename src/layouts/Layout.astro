---
import '@aifuxi/semi-theme-default/base.css'
import '@aifuxi/semi-theme-default/button.css'
import '@aifuxi/semi-theme-default/card.css'
import '@aifuxi/semi-theme-default/grid.css'
import '@aifuxi/semi-theme-default/layout.css'
import '@aifuxi/semi-theme-default/list.css'
import '@aifuxi/semi-theme-default/space.css'
import '@aifuxi/semi-theme-default/typography.css'
import { Button } from '@aifuxi/semi-ui-vue/button'
import { Layout, LayoutFooter, LayoutHeader } from '@aifuxi/semi-ui-vue/layout'
import { Space } from '@aifuxi/semi-ui-vue/space'
import { Text } from '@aifuxi/semi-ui-vue/typography'
import { site } from '../config/site'
import '../styles/site.css'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const pageTitle = title + ' · ' + site.author
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site)

const navigation = [
  { href: '/blog/', label: '文章' },
  { href: '/projects/', label: '项目' },
  { href: '/about/', label: '关于' },
]
---

<!doctype html>
<html lang="zh-CN" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('blog-theme')
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme
        }
      } catch {
        // 存储被禁用时由 CSS 跟随系统主题。
      }
    </script>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <script is:inline>
      const theme = document.documentElement.dataset.theme
      if (theme === 'dark' || (!theme && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.body.setAttribute('theme-mode', 'dark')
      }
    </script>
    <Text class="skip-link" link={{ href: '#main' }}>
      跳到正文
    </Text>
    <Layout>
      <LayoutHeader tagName="header">
        <div class="site-shell site-bar">
          <Text link={{ href: '/', 'aria-label': site.author + ' 首页' }} strong>
            {site.author}
          </Text>
          <Space>
            <nav aria-label="主导航">
              <Space wrap>
                {navigation.map(({ href, label }) => (
                  <Text
                    link={{
                      href,
                      'aria-current': Astro.url.pathname.startsWith(href) ? 'page' : undefined,
                    }}
                  >
                    {label}
                  </Text>
                ))}
              </Space>
            </nav>
            <Button id="theme-toggle" class="theme-toggle" theme="outline" type="tertiary" hidden>
              <span id="theme-label">深色</span>
            </Button>
          </Space>
        </div>
      </LayoutHeader>
      <slot />
      <LayoutFooter tagName="footer">
        <div class="site-shell site-bar">
          <Text type="secondary">{site.author}</Text>
          <Text link={{ href: '#top' }}>返回顶部</Text>
        </div>
      </LayoutFooter>
    </Layout>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle')
      const label = document.querySelector('#theme-label')
      const system = window.matchMedia('(prefers-color-scheme: dark)')
      const root = document.documentElement

      function updateTheme() {
        const dark = root.dataset.theme === 'dark' || (!root.dataset.theme && system.matches)
        if (dark) {
          document.body.setAttribute('theme-mode', 'dark')
        } else {
          document.body.removeAttribute('theme-mode')
        }

        if (label) {
          label.textContent = dark ? '浅色' : '深色'
        }
      }

      if (button) {
        updateTheme()
        button.hidden = false

        button.addEventListener('click', () => {
          const next = document.body.hasAttribute('theme-mode') ? 'light' : 'dark'
          root.dataset.theme = next
          updateTheme()

          try {
            localStorage.setItem('blog-theme', next)
          } catch {
            // 主题仍在当前页生效。
          }
        })

        system.addEventListener('change', updateTheme)

        window.addEventListener('storage', (event) => {
          if (event.key === 'blog-theme' || event.key === null) {
            if (event.newValue === 'light' || event.newValue === 'dark') {
              root.dataset.theme = event.newValue
            } else {
              delete root.dataset.theme
            }

            updateTheme()
          }
        })
      }
    </script>
  </body>
</html>
