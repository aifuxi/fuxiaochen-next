---
import '@aifuxi/semi-theme-default/base.css'
import '@aifuxi/semi-theme-default/button.css'
import '@aifuxi/semi-theme-default/icon.css'
import '@aifuxi/semi-theme-default/layout.css'
import '@aifuxi/semi-theme-default/typography.css'
import IconArrowUp from '@aifuxi/semi-icons-vue/icons/IconArrowUp'
import IconMoon from '@aifuxi/semi-icons-vue/icons/IconMoon'
import IconSun from '@aifuxi/semi-icons-vue/icons/IconSun'
import { Button } from '@aifuxi/semi-ui-vue/button'
import { Layout, LayoutFooter, LayoutHeader } from '@aifuxi/semi-ui-vue/layout'
import { Text } from '@aifuxi/semi-ui-vue/typography'
import BrandLogo from '../assets/brand-logo.svg'
import ModernTheme from '../components/ModernTheme.astro'
import { site } from '../config/site'
import '../styles/site.css'

interface Props {
  title?: string
  description: string
  noindex?: boolean
}

const { title, description, noindex } = Astro.props
const pageTitle = title ? `${title} · ${site.name}` : site.name
const canonical = !noindex && Astro.site && new URL(Astro.url.pathname, Astro.site)
const currentPath = Astro.url.pathname.replace(/\/?$/, '/')

const navigation = [
  { href: '/blog/', label: '文章' },
  { href: '/categories/', label: '主题' },
  { href: '/projects/', label: '项目' },
  { href: '/about/', label: '关于' },
]
---

<!doctype html>
<html lang="zh-CN" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" />
    <ModernTheme />
    <script is:inline>
      try {
        const theme = localStorage.getItem('blog-theme')
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme
        }
      } catch {
        // 存储被禁用时由 CSS 跟随系统主题。
      }
    </script>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical.href} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <script is:inline>
      const theme = document.documentElement.dataset.theme
      if (theme === 'dark' || (!theme && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.body.setAttribute('theme-mode', 'dark')
      }
    </script>
    <Text class="skip-link" link={{ href: '#main' }}>
      跳到正文
    </Text>
    <Layout class="site-layout">
      <LayoutHeader tagName="header" class="site-header">
        <div class="site-shell site-bar">
          <a class="site-brand" href="/" aria-label={`${site.name}，返回首页`}>
            <BrandLogo aria-hidden="true" focusable="false" />
            <span>{site.name}</span>
          </a>
          <div class="site-header-actions">
            <nav aria-label="主导航">
              <ul class="site-nav">
                {navigation.map(({ href, label }) => (
                  <li>
                    <a
                      href={href}
                      aria-current={
                        currentPath === href
                          ? 'page'
                          : currentPath.startsWith(href)
                            ? 'location'
                            : undefined
                      }
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <Button id="theme-toggle" class="theme-toggle" theme="outline" type="tertiary" hidden>
              <span class="icon-label">
                <IconSun class="light-icon" aria-hidden="true" />
                <IconMoon class="dark-icon" aria-hidden="true" />
                <span id="theme-label">深色</span>
              </span>
            </Button>
          </div>
        </div>
      </LayoutHeader>
      <slot />
      <LayoutFooter tagName="footer" class="site-footer">
        <div class="site-shell site-bar">
          <Text type="secondary">{site.author}</Text>
          <a class="site-link icon-label" href="#top">
            <IconArrowUp aria-hidden="true" />
            返回顶部
          </a>
        </div>
      </LayoutFooter>
    </Layout>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle')
      const label = document.querySelector('#theme-label')
      const system = window.matchMedia('(prefers-color-scheme: dark)')
      const root = document.documentElement

      function updateTheme() {
        const dark = root.dataset.theme === 'dark' || (!root.dataset.theme && system.matches)
        if (dark) {
          document.body.setAttribute('theme-mode', 'dark')
        } else {
          document.body.removeAttribute('theme-mode')
        }

        if (label) {
          label.textContent = dark ? '浅色' : '深色'
        }

        button?.setAttribute('aria-label', dark ? '切换到浅色主题' : '切换到深色主题')
      }

      if (button) {
        updateTheme()
        button.hidden = false

        button.addEventListener('click', () => {
          const next = document.body.hasAttribute('theme-mode') ? 'light' : 'dark'
          root.dataset.theme = next
          updateTheme()

          try {
            localStorage.setItem('blog-theme', next)
          } catch {
            // 主题仍在当前页生效。
          }
        })

        system.addEventListener('change', updateTheme)

        window.addEventListener('storage', (event) => {
          if (event.key === 'blog-theme' || event.key === null) {
            if (event.newValue === 'light' || event.newValue === 'dark') {
              root.dataset.theme = event.newValue
            } else {
              delete root.dataset.theme
            }

            updateTheme()
          }
        })
      }
    </script>
  </body>
</html>
