---
import '@aifuxi/semi-theme-default/card.css'
import { Card } from '@aifuxi/semi-ui-vue/card'
import { Paragraph, Title } from '@aifuxi/semi-ui-vue/typography'
import ProjectSource from '../components/ProjectSource.vue'
import { project } from '../config/site'
import Layout from '../layouts/Layout.astro'
---

<Layout title="开源项目" description="浏览 fuxiaochen 的开源项目。">
  <main class="site-shell site-main content-page" id="main" tabindex="-1">
    <div class="page-stack">
      <Title heading={1}>开源项目</Title>
      <Card>
        <Title slot="title" heading={2}>
          {project.title}
        </Title>
        <div class="project-details">
          <Paragraph type="secondary">{project.summary}</Paragraph>
          <ProjectSource />
        </div>
      </Card>
    </div>
  </main>
</Layout>

<style>
  .project-details {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    align-items: center;
  }
</style>
