---
import { Card } from '@aifuxi/semi-ui-vue/card'
import { Space } from '@aifuxi/semi-ui-vue/space'
import { Title } from '@aifuxi/semi-ui-vue/typography'
import PostList from '../../components/PostList.vue'
import Layout from '../../layouts/Layout.astro'
import { getPublicPosts, toSearchPost } from '../../lib/posts'

const posts = await getPublicPosts()
---

<Layout title="文章" description="浏览已发布的前端开发笔记。">
  <main class="site-shell site-main content-page" id="main" tabindex="-1">
    <Space vertical align="start" spacing="loose">
      <Title heading={1}>文章</Title>
      <Card>
        <PostList posts={posts.map(toSearchPost)} />
      </Card>
    </Space>
  </main>
</Layout>
