---
import IconArrowLeft from '@aifuxi/semi-icons-vue/icons/IconArrowLeft'
import IconCalendar from '@aifuxi/semi-icons-vue/icons/IconCalendar'
import { Button } from '@aifuxi/semi-ui-vue/button'
import { Paragraph, Title } from '@aifuxi/semi-ui-vue/typography'
import { getImage, Image } from 'astro:assets'
import { render, type CollectionEntry } from 'astro:content'
import ArticleTocLinks from '../../components/ArticleTocLinks.astro'
import TagLinks from '../../components/TagLinks.astro'
import Layout from '../../layouts/Layout.astro'
import { getPublicPosts, toPostSummary } from '../../lib/posts'

export async function getStaticPaths() {
  return (await getPublicPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }))
}

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const { title, summary, publishedAt, topic } = toPostSummary(post)
const { cover, tags = [], updatedAt } = post.data
const updatedDate = updatedAt?.toISOString().slice(0, 10)
const sections = headings.filter(({ depth }) => depth === 2 || depth === 3)
const image = cover && { src: (await getImage({ src: cover.image })).src, alt: cover.alt }
---

<Layout
  title={title}
  description={summary}
  article={{ publishedAt, updatedAt: updatedDate, image }}
>
  <main class="site-shell site-main" id="main" tabindex="-1">
    <article class:list={['article-layout', { 'with-toc': sections.length }]} data-pagefind-body>
      <header class="article-heading page-heading">
        <div>
          <a class="site-link icon-label" href="/blog/" data-pagefind-ignore>
            <IconArrowLeft aria-hidden="true" />
            返回文章列表
          </a>
        </div>
        <Title heading={1}>{title}</Title>
        <div class="article-meta" data-pagefind-ignore>
          <time class="icon-label" datetime={publishedAt}>
            <IconCalendar aria-hidden="true" />
            {publishedAt}
          </time>
          {updatedDate && (
            <span>
              更新于 <time datetime={updatedDate}>{updatedDate}</time>
            </span>
          )}
          {topic && (
            <a class="site-link" href={'/categories/' + post.data.topic + '/'}>
              {topic}
            </a>
          )}
        </div>
        <Paragraph type="secondary">{summary}</Paragraph>
        {tags.length > 0 && <TagLinks tags={tags} />}
        {cover && (
          <Image class="article-cover" src={cover.image} alt={cover.alt} layout="constrained" />
        )}
      </header>
      {sections.length > 0 && (
        <nav class="article-toc" aria-label="文章目录">
          <details class="toc-compact">
            <summary>文章目录</summary>
            <ArticleTocLinks sections={sections} />
          </details>
          <div class="toc-desktop">
            <h2>文章目录</h2>
            <ArticleTocLinks sections={sections} />
          </div>
        </nav>
      )}
      <div class="article-body">
        <Content />
      </div>
      <template id="article-copy-controls">
        <span class="article-copy-status" role="status"></span>
        <Button size="small" theme="borderless" type="tertiary" htmlType="button">
          复制代码
        </Button>
      </template>
    </article>
  </main>
</Layout>

<script>
  const template = document.querySelector<HTMLTemplateElement>('#article-copy-controls')

  if (template) {
    const blocks = Array.from(document.querySelectorAll('.article-body .article-code-block'))

    for (const [index, block] of blocks.entries()) {
      const toolbar = block.querySelector('.article-code-toolbar')
      const code = block.querySelector<HTMLElement>('pre > code')
      const controls = template.content.cloneNode(true) as DocumentFragment
      const button = controls.querySelector('button')
      const status = controls.querySelector('[role="status"]')
      if (!toolbar || !code || !button || !status) {
        continue
      }

      let reset: number | undefined
      let previousMessage = ''

      const copyCode = async () => {
        let message = '已复制'
        try {
          await navigator.clipboard.writeText(code.textContent ?? '')
        } catch {
          message = '复制失败'
        }

        previousMessage = previousMessage === message ? `${message}\u00a0` : message
        status.textContent = previousMessage
        window.clearTimeout(reset)

        reset = window.setTimeout(() => {
          status.textContent = ''
        }, 2000)
      }

      if ('CommandEvent' in window) {
        code.id ||= `article-code-${index + 1}`
        button.setAttribute('command', '--copy-code')
        button.setAttribute('commandfor', code.id)
        code.addEventListener('command', copyCode)
      } else {
        button.addEventListener('click', copyCode)
      }

      toolbar.append(controls)
    }
  }

  const toc = document.querySelector<HTMLElement>('.article-toc')

  if (toc) {
    const list = toc.querySelector('.toc-desktop ul')

    const compactLinks = new Map(
      Array.from(toc.querySelectorAll<HTMLAnchorElement>('.toc-compact a'), (link) => [
        link.hash,
        link,
      ]),
    )

    const sections = Array.from(list?.querySelectorAll<HTMLAnchorElement>('a') ?? []).flatMap(
      (link) => {
        const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)))
        return heading ? [{ link, heading, compactLink: compactLinks.get(link.hash) }] : []
      },
    )

    const first = sections[0]
    const last = sections.at(-1)
    const root = document.documentElement
    const header = document.querySelector<HTMLElement>('.site-header')
    let active: (typeof sections)[number] | undefined
    let frame: number | undefined

    const updateCurrentSection = () => {
      frame = undefined
      if (!first || !last) {
        return
      }

      const margin = parseFloat(getComputedStyle(first.heading).scrollMarginBlockStart)
      const readingStart = (header?.getBoundingClientRect().bottom ?? 0) + margin + 1

      const atBottom =
        root.scrollHeight > innerHeight && root.scrollHeight - scrollY - innerHeight <= 1

      const next = atBottom
        ? last
        : sections.findLast(({ heading }) => heading.getBoundingClientRect().top <= readingStart)

      if (active === next) {
        return
      }

      active?.link.removeAttribute('aria-current')
      active?.compactLink?.removeAttribute('aria-current')
      active = next
      active?.link.setAttribute('aria-current', 'location')
      active?.compactLink?.setAttribute('aria-current', 'location')

      if (active && list && list.clientHeight > 0 && list.scrollHeight > list.clientHeight) {
        const viewport = list.getBoundingClientRect()
        const item = active.link.getBoundingClientRect()

        list.scrollTop +=
          Math.min(0, item.top - viewport.top) + Math.max(0, item.bottom - viewport.bottom)
      }
    }

    function scheduleUpdate() {
      frame ??= requestAnimationFrame(updateCurrentSection)
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true })
    window.addEventListener('hashchange', scheduleUpdate)
    window.addEventListener('pageshow', scheduleUpdate)
    const article = toc.closest('article')
    const resizeObserver = new ResizeObserver(scheduleUpdate)
    if (article) {
      resizeObserver.observe(article)
    }

    if (header) {
      resizeObserver.observe(header)
    }

    scheduleUpdate()
  }
</script>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, var(--blog-content-width));
    justify-content: center;
    align-items: start;
    gap: 24px clamp(24px, 4vw, 56px);
  }

  .article-heading {
    gap: 12px;
  }

  .article-heading :global(p) {
    font-size: 1rem;
    line-height: 1.65;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    color: var(--semi-color-text-1);
    font-variant-numeric: tabular-nums;
  }

  .article-cover {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
    border-radius: var(--semi-border-radius-medium);
  }

  .article-toc {
    padding: 14px 16px;
    border: 1px solid var(--semi-color-border);
    border-radius: var(--semi-border-radius-medium);
    background: var(--semi-color-bg-1);
    overflow-wrap: anywhere;
  }

  .article-toc h2 {
    margin: 0 0 4px;
    font-size: 0.875rem;
  }

  .toc-desktop {
    display: none;
  }

  .toc-compact summary {
    min-block-size: 24px;
    font-weight: 600;
    cursor: pointer;
  }

  .toc-compact[open] summary {
    margin-block-end: 8px;
  }

  .article-toc :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-toc :global(.toc-subsection) {
    padding-inline-start: 12px;
  }

  .article-toc :global(a) {
    display: block;
    padding: 4px 6px;
    border-radius: var(--semi-border-radius-small);
    color: var(--semi-color-text-1);
    text-decoration: none;
  }

  .article-toc :global(a[aria-current='location']) {
    background: var(--semi-color-fill-0);
    color: var(--semi-color-link);
    font-weight: 600;
  }

  .article-toc :global(a:is(:hover, :focus-visible)) {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .article-body {
    min-inline-size: 0;
    font-size: 1rem;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .article-body > :global(:first-child) {
    margin-block-start: 0;
  }

  .article-body :global(:is(h2, h3, h4, h5, h6)) {
    margin-block: 1.6em 0.5em;
    line-height: 1.35;
    scroll-margin-block-start: 24px;
  }

  .article-body :global(a) {
    color: var(--semi-color-link);
    text-underline-offset: 0.18em;
  }

  .article-body :global(:is(img, video)) {
    max-inline-size: 100%;
    block-size: auto;
  }

  .article-body :global(:not(pre) > code) {
    padding: 0.1em 0.3em;
    border-radius: var(--semi-border-radius-small);
    background: var(--semi-color-fill-0);
  }

  .article-body :global(pre) {
    box-sizing: border-box;
    max-inline-size: 100%;
    padding: 12px 16px;
    border: 1px solid var(--semi-color-border);
    border-radius: var(--semi-border-radius-medium);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.65;
    overflow-wrap: normal;
  }

  .article-body :global(.article-code-block) {
    margin-block: 1em;
    border: 1px solid var(--semi-color-border);
    border-radius: var(--semi-border-radius-medium);
  }

  .article-body :global(.article-code-toolbar) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px 4px 16px;
    border-block-end: 1px solid var(--semi-color-border);
    border-radius: var(--semi-border-radius-medium) var(--semi-border-radius-medium) 0 0;
    background: var(--semi-color-bg-1);
    color: var(--semi-color-text-1);
    font-size: 0.875rem;
  }

  .article-copy-status {
    margin-inline-start: auto;
  }

  .article-body :global(.article-code-block pre) {
    margin: 0;
    border: 0;
    border-radius: 0 0 var(--semi-border-radius-medium) var(--semi-border-radius-medium);
  }

  :global(:root[data-theme='light']) .article-body :global(.astro-code, .astro-code span) {
    color: var(--shiki-light) !important;
    background-color: var(--shiki-light-bg) !important;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .article-body :global(.astro-code, .astro-code span) {
      color: var(--shiki-light) !important;
      background-color: var(--shiki-light-bg) !important;
    }
  }

  @media (min-width: 62rem) {
    .article-layout.with-toc {
      grid-template-columns: minmax(0, var(--blog-content-width)) var(--blog-sidebar-width);
    }

    .article-toc {
      grid-column: 2;
      grid-row: 1 / 3;
      display: flex;
      flex-direction: column;
      position: sticky;
      inset-block-start: calc(var(--blog-sticky-header-height) + 24px);
      max-block-size: calc(100dvh - var(--blog-sticky-header-height) - 48px);
    }

    .toc-compact {
      display: none;
    }

    .toc-desktop {
      display: flex;
      flex-direction: column;
      min-block-size: 0;
    }

    .toc-desktop :global(ul) {
      overflow-y: auto;
    }
  }
</style>
